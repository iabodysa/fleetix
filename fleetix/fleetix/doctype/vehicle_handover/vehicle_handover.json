   "label": "Signatures"
  },
  {
   "fieldname": "from_signature",
   "fieldtype": "Signature",
   "label": "Handing Over Signature",
   "mandatory_depends_on": "eval:['Documentation and Signatures', 'Completed'].includes(doc.status)"
  },
  {
   "fieldname": "column_break_signatures",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "to_signature",
   "fieldtype": "Signature",
   "label": "Receiving Signature",
   "mandatory_depends_on": "eval:['Documentation and Signatures', 'Completed'].includes(doc.status)"
  },
  {
   "allow_on_submit": 1,
