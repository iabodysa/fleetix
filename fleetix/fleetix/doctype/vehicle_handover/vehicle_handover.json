   "non_negative": 1
  },
  {
   "default": "0",
   "depends_on": "eval:doc.odometer_flagged",
   "fieldname": "odometer_flagged",
   "fieldtype": "Check",
   "in_standard_filter": 1,
   "label": "Odometer Flagged",
   "no_copy": 1,
   "read_only": 1
  },
  {
   "fetch_from": "vehicle.city",
   "fetch_if_empty": 1,
   "fieldname": "city",
   "fieldtype": "Link",
   "label": "City",
   "options": "City"
  },
  {
   "fieldname": "column_break_handover",
