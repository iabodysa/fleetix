 "fields": [
  {
   "fieldname": "handover_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Handover Type",
   "options": "Handover\nReturn\nTransfer",
   "reqd": 1
  },
  {
   "fieldname": "vehicle",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Vehicle",
   "options": "Vehicle",
   "reqd": 1
  },
  {
   "default": "Now",
