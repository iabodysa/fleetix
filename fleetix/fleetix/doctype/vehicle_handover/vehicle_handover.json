  },
  {
   "fieldname": "to_driver",
   "fieldtype": "Link",
   "label": "To Driver",
   "link_filters": "[[\"Driver\", \"active\", \"=\", 1]]",
   "options": "Driver"
  },
  {
   "fetch_from": "vehicle.current_project",
   "fetch_if_empty": 1,
   "fieldname": "from_project",
   "fieldtype": "Link",
   "label": "From Project",
   "options": "Project"
  },
  {
   "fieldname": "to_project",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "To Project",
   "options": "Project"
  },
  {
   "depends_on": "eval:doc.status != 'Requested'",
   "fieldname": "inspection_section",
   "fieldtype": "Section Break",
   "label": "Inspection"
  },
  {
   "fieldname": "inspection",
   "fieldtype": "Link",
   "label": "Inspection",
   "mandatory_depends_on": "eval:doc.status != 'Requested'",
   "options": "Vehicle Inspection"
  },
  {
   "fieldname": "damages_found",
   "fieldtype": "Table",
   "label": "Damages Found",
   "options": "Vehicle Handover Damage"
  },
  {
   "depends_on": "eval:['Documentation and Signatures', 'Completed'].includes(doc.status)",
