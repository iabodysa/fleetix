 "fields": [
  {
   "default": "Periodic",
   "fieldname": "maintenance_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Maintenance Type",
   "options": "Periodic\nEmergency",
   "reqd": 1
  },
  {
   "fieldname": "vehicle",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Vehicle",
   "link_filters": "[[\"Vehicle\", \"active\", \"=\", 1]]",
   "options": "Vehicle",
   "reqd": 1
  },
  {
   "fetch_from": "vehicle.current_driver",
   "fetch_if_empty": 1,
   "fieldname": "driver",
   "fieldtype": "Link",
   "label": "Driver",
   "link_filters": "[[\"Driver\", \"active\", \"=\", 1]]",
   "options": "Driver",
   "reqd": 1
  },
  {
   "fetch_from": "vehicle.current_project",
   "fetch_if_empty": 1,
   "fieldname": "project",
   "fieldtype": "Link",
   "label": "Project",
   "options": "Project",
   "reqd": 1
  },
  {
   "fetch_from": "vehicle.company",
   "fetch_if_empty": 1,
   "fieldname": "company",
   "fieldtype": "Link",
   "hidden": 1,
   "label": "Company",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "workshop",
   "fieldtype": "Data",
   "label": "Workshop"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "fieldname": "column_break_maintenance",
   "fieldtype": "Column Break"
  },
  {
   "allow_on_submit": 1,
   "default": "Due Alert",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Status",
   "no_copy": 1,
   "options": "Due Alert\nDriver Arrived\nFull Inspection\nApproved\nService\nFinal Check\nCompleted",
   "read_only": 1,
   "reqd": 1
  },
  {
   "depends_on": "eval:['Driver Arrived', 'Full Inspection', 'Approved', 'Service', 'Final Check', 'Completed'].includes(doc.status)",
   "fieldname": "visit_datetime",
   "fieldtype": "Datetime",
   "label": "Visit Date and Time",
   "mandatory_depends_on": "eval:['Driver Arrived', 'Full Inspection', 'Approved', 'Service', 'Final Check', 'Completed'].includes(doc.status)"
  },
  {
   "fieldname": "worker",
   "fieldtype": "Link",
   "label": "Worker",
   "options": "Employee",
   "read_only": 1
  },
  {
   "depends_on": "eval:['Driver Arrived', 'Full Inspection', 'Approved', 'Service', 'Final Check', 'Completed'].includes(doc.status)",
   "fetch_from": "vehicle.last_odometer",
   "fetch_if_empty": 1,
   "fieldname": "odometer",
   "fieldtype": "Int",
   "label": "Odometer (km)",
   "mandatory_depends_on": "eval:['Full Inspection', 'Approved', 'Service', 'Final Check', 'Completed'].includes(doc.status)",
   "non_negative": 1
  },
  {
   "depends_on": "eval:['Driver Arrived', 'Full Inspection', 'Approved', 'Service', 'Final Check', 'Completed'].includes(doc.status)",
   "fieldname": "inspection",
   "fieldtype": "Link",
   "label": "Full Inspection",
   "mandatory_depends_on": "eval:['Full Inspection', 'Approved', 'Service', 'Final Check', 'Completed'].includes(doc.status)",
   "options": "Vehicle Inspection"
  },
  {
   "depends_on": "eval:(doc.photos || []).length",
   "fieldname": "photos_section",
   "fieldtype": "Section Break",
   "label": "Photos"
  },
  {
   "fieldname": "photo_gallery",
   "fieldtype": "HTML",
   "label": "Photo Gallery"
  },
  {
   "depends_on": "eval:['Approved', 'Service', 'Final Check', 'Completed'].includes(doc.status)",
   "fieldname": "service_section",
   "fieldtype": "Section Break",
   "label": "Service"
  },
  {
   "fieldname": "components_replaced",
   "fieldtype": "Table",
   "label": "Components Replaced",
   "options": "Maintenance Component"
  },
  {
   "fieldname": "items_issued",
   "fieldtype": "Link",
   "label": "Items Issued from Warehouse",
   "options": "Stock Entry"
  },
  {
   "fieldname": "cost",
